# Auth.js (NextAuth) — generate a random secret, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Required for non-Vercel hosts (Vercel auto-trusts its own host)
# AUTH_TRUST_HOST=true

# Neon PostgreSQL
# DATABASE_URL: pooled connection (runtime queries)
# DIRECT_URL: unpooled connection (prisma migrate / db push)
DATABASE_URL=
DIRECT_URL=

# Public site URL (used for metadata and Auth.js redirects)
NEXT_PUBLIC_SITE_URL=https://adaobimuonagoyouthcenter.vercel.app
